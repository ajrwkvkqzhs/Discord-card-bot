{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "discord-card-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "discord-card-db",
      "database_id": "d8a9933c-4d38-4c61-abf8-318df86a4ce0"
    }
  ],
  "secrets": {
    "required": [
      "DISCORD_APPLICATION_ID",
      "DISCORD_PUBLIC_KEY",
      "DISCORD_TOKEN"
    ]
  }
}
